<mxfile host="app.diagrams.net">
  <diagram id="flatly-architecture" name="Architecture">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Flatly: system architecture" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="600" height="40" as="geometry" />
        </mxCell>

        <!-- ===== Browser ===== -->
        <mxCell id="browser" value="User's browser: React single-page app (Vite)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="380" height="490" as="geometry" />
        </mxCell>
        <mxCell id="fe_pages" value="&lt;b&gt;Pages&lt;/b&gt;&lt;br&gt;Home · Login · Sign up · Forgot password&lt;br&gt;Choose role · Buyer · Seller&lt;br&gt;Profile · Admin (audit trail)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="fe_buyer" value="&lt;b&gt;Buyer UI&lt;/b&gt;&lt;br&gt;Budget form · loan cards · recommended towns&lt;br&gt;Town heat map · saved searches · saved flats map" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="205" width="340" height="65" as="geometry" />
        </mxCell>
        <mxCell id="fe_seller" value="&lt;b&gt;Seller UI&lt;/b&gt;&lt;br&gt;Property form · photo upload · valuation breakdown" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="285" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="fe_shared" value="&lt;b&gt;Shared modules&lt;/b&gt;&lt;br&gt;supabaseClient.js · saves.js · audit.js&lt;br&gt;api.js (backend address) · mrtLines.js · scroll.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="350" width="340" height="65" as="geometry" />
        </mxCell>
        <mxCell id="fe_maps" value="&lt;b&gt;Maps&lt;/b&gt;: Leaflet (react-leaflet) + OneMap tiles&lt;br&gt;Town outlines: public/sg_towns.geojson" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="430" width="340" height="55" as="geometry" />
        </mxCell>
        <mxCell id="fe_note" value="Talks to Supabase directly for login, saves, profile and audit log; to the backend only for calculations." style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#555555;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="495" width="340" height="50" as="geometry" />
        </mxCell>

        <!-- ===== Hosting ===== -->
        <mxCell id="hosting" value="Hosting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontStyle=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="470" y="70" width="300" height="190" as="geometry" />
        </mxCell>
        <mxCell id="host_vercel" value="&lt;b&gt;Vercel services&lt;/b&gt; (coming soon, vercel.json)&lt;br&gt;/api/* → be service (FastAPI)&lt;br&gt;/* → fe service (React build)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="490" y="105" width="260" height="65" as="geometry" />
        </mxCell>
        <mxCell id="host_local" value="&lt;b&gt;Local (running now)&lt;/b&gt;&lt;br&gt;Vite :5173 (proxies /api)&lt;br&gt;Uvicorn :8000 (python main.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="490" y="182" width="260" height="65" as="geometry" />
        </mxCell>

        <!-- ===== Backend ===== -->
        <mxCell id="be" value="Backend: FastAPI (BE/)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontStyle=1;arcSize=3;" vertex="1" parent="1">
