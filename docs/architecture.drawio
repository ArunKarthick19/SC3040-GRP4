        <!-- ===== Supabase ===== -->
        <mxCell id="sb" value="Supabase (cloud)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;fontStyle=1;arcSize=3;" vertex="1" parent="1">
