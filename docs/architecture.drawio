        <mxCell id="d_comps" value="seller_comparables.json" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=8;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
